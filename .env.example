# Nothing in this package reads a variable of its own; these are read by the libraries it drives.

# Hugging Face cache root (models and datasets). Default: ~/.cache/huggingface
# HF_HOME=~/.cache/huggingface

# Which GPU a run sees on a multi-GPU machine, numbered in PCI bus order.
# CUDA_DEVICE_ORDER=PCI_BUS_ID
# CUDA_VISIBLE_DEVICES=0
